# =====================================================
# 🎯 BMSChat — ПРИМЕР ПЕРЕМЕННЫХ ОКРУЖЕНИЯ
# =====================================================
# Это шаблон. Скопируйте в .env и заполните своими данными.
#
# ВАЖНО: НЕ добавляйте реальные секреты в этот файл!
# Он загружается на GitHub.
#
# НА ONREZA: большинство переменных задаются в панели
# управления проектом (Settings → Environment Variables).
# Файл .env в репозитории НЕ используется в продакшене.
# =====================================================

# -----------------------------------------------------
# 🌐 СЕРВЕР
# -----------------------------------------------------
# Onreza подставляет PORT автоматически. Значение ниже —
# только для локального запуска.
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# -----------------------------------------------------
# 🔐 БЕЗОПАСНОСТЬ
# -----------------------------------------------------
# Замените на 64+ случайных символов перед деплоем!
# Генерация: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# -----------------------------------------------------
# 🔐 PEPPER (ПЕРЕЦ) — ОБЯЗАТЕЛЬНО!
# -----------------------------------------------------
# Секретный ключ для дополнительной защиты паролей.
# Замените на 64+ случайных символов.
# Генерация: openssl rand -hex 32
PASSWORD_PEPPER=your_secret_pepper_here

# -----------------------------------------------------
# 🔐 БЛОКИРОВКА АККАУНТА
# -----------------------------------------------------
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30

# -----------------------------------------------------
# 🛡️ RATE LIMITING
# -----------------------------------------------------
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_MINUTES=15

# -----------------------------------------------------
# 💾 БАЗА ДАННЫХ (PostgreSQL)
# -----------------------------------------------------
# На Onreza DATABASE_URL подставляется платформой
# автоматически, если для Managed PostgreSQL включена
# опция «Привязка к деплоям» (Bind to deployments).
# В этом случае задавать её вручную не нужно.
#
# Для локального запуска — укажите строку подключения
# к вашему локальному PostgreSQL.
DATABASE_URL=postgresql://user:password@localhost:5432/bmschat

# Настройки пула
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONNECTION_TIMEOUT=5000

# SSL для PostgreSQL.
# • Для внутренней Managed PostgreSQL на Onreza — false (по умолчанию).
# • Если строка подключения содержит ?sslmode=require — поставьте true.
DB_SSL=false

# -----------------------------------------------------
# 📸 ФАЙЛЫ
# -----------------------------------------------------
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# -----------------------------------------------------
# 🌍 CORS
# -----------------------------------------------------
# В продакшене укажите конкретный домен, а не *.
# Пример: https://bmschat-vv82bk-nwjc.onreza.app
CORS_ORIGIN=*