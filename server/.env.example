# Это шаблон. Скопируйте в .env и заполните своими данными.

PORT=5000
HOST=0.0.0.0
NODE_ENV=development

JWT_SECRET=your_secret_key_here
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

DB_TYPE=sqlite
DB_PATH=./database/chat.db

UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

CORS_ORIGIN=*