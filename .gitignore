app/**/generated_plugins.cmake
app/**/generated_plugin_registrant.cc
app/**/generated_plugin_registrant.h

# ⚠️ pubspec.lock — КОММИТИМ (для приложений, не библиотек).
#    Это гарантирует одинаковые версии зависимостей у всех.
#    НЕ добавлять сюда!

